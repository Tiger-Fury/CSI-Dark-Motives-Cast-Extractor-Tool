<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>Assets\Tiger-Fury.ico</ApplicationIcon>
    <AssemblyName>CSI-Cast-Tool</AssemblyName>
    <Product>CSI Cast Tool</Product>
    <Company>Tiger Fury</Company>
    <Authors>Tiger Fury</Authors>
    <Copyright>Copyright © 2026 Tiger Fury</Copyright>
    <Version>2.0.0</Version>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CSI.CastTool.Core\CSI.CastTool.Core.csproj" />
    <EmbeddedResource Include="Assets\Tiger-Fury.ico" LogicalName="Tiger-Fury.ico" />
  </ItemGroup>
</Project>
